# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth — avoids committing nested tooling like lead-generator)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / local tooling
.cursor/
.claude/

# large local assets & binaries (keep out of git history)
Campaign Videos and logos/
*.exe

# Superseded profile builds. The live profile is public/profile/ (served at
# /profile) — these are earlier standalone/zip versions kept only as local
# copies. They duplicate ~75MB of video, so never let them into git history.
LawuMediaProfile/
LawuMediaSite/
*.zip
